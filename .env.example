# Server Configuration
PORT=3000

# Twilio Credentials (get from twilio.com/console)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio Phone Number (with country code, e.g., +15551234567)
TWILIO_FROM=your_twilio_number_here

# Marcos' Personal Number (to detect when it's you texting, e.g., +15551234567)
MARCOS_NUMBER=your_personal_number_here

# Anthropic API Key (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
